{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Avinashp7509/archi-made-easy/schemas/common.schema.json",
  "title": "Archi-Made-Easy Shared Definitions",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
      "maxLength": 35
    },
    "translations": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-zA-Z0-9]*(\\.[a-z][a-zA-Z0-9]*)*$" },
      "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 400 },
      "maxProperties": 600
    },
    "animation": {
      "enum": ["trace", "none"]
    },
    "visualPreset": {
      "enum": ["classic", "signal-flow", "blueprint", "editorial"]
    },
    "qualityProfile": {
      "enum": ["standard", "showcase"]
    },
    "portableOutputPath": {
      "description": "A portable POSIX-relative HTML output path. It must be safe to interpret identically on every supported host filesystem.",
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/]+(?:/[^/]+)*$",
      "allOf": [
        { "pattern": "(?:^|/)[^/]+[.][Hh][Tt][Mm][Ll]$" },
        { "not": { "pattern": "[\\\\<>:\"|?*\\u0000-\\u001F\\u007F-\\u009F]" } },
        { "not": { "pattern": "[\\uD800-\\uDFFF]" } },
        { "not": { "pattern": "(^|/)[.]{1,2}(/|$)" } },
        { "not": { "pattern": "[. ](/|$)" } },
        { "not": { "pattern": "(^|/)[^/]{256}" } },
        {
          "not": {
            "pattern": "(^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Nn][Ii][Nn][$]|[Cc][Oo][Nn][Oo][Uu][Tt][$]|[Cc][Oo][Mm][1-9¹²³]|[Ll][Pp][Tt][1-9¹²³])(?:[.]|/|$)"
          }
        },
        {
          "not": {
            "pattern": "(^|/)[^/]*~[1-9][0-9]*(?:[.]|/|$)"
          }
        }
      ]
    },
    "side": {
      "enum": ["left", "right", "top", "bottom"]
    },
    "relationshipWidth": {
      "type": "number",
      "minimum": 0.5
    },
    "point": {
      "type": "array",
      "prefixItems": [
        { "type": "number" },
        { "type": "number" }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "componentType": {
      "enum": ["frontend", "backend", "database", "cloud", "security", "messagebus", "external"]
    },
    "nodeIcon": {
      "description": "Decorative corner icon. Omit the icon field for the type default; none hides it. Does not change type, color, or legend grouping.",
      "enum": ["calendar", "clock", "person", "briefcase", "flag", "moon", "frontend", "backend", "database", "cloud", "security", "messagebus", "external", "start", "active", "waiting", "decision", "success", "failure", "stop", "neutral", "none"]
    },
    "brandMark": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "anyOf": [
            { "maxLength": 80, "pattern": "^[^\\r\\n]+$" },
            { "pattern": "^https?://" }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "sha256"],
          "properties": {
            "url": { "type": "string", "minLength": 8, "maxLength": 2048, "pattern": "^https?://" },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        }
      ]
    },
    "variant": {
      "enum": ["default", "emphasis", "security", "dashed"]
    },
    "legendMode": {
      "enum": ["auto", "all", "hidden"]
    },
    "legendEntry": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "visible": { "type": "boolean" }
      }
    },
    "guidedViews": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "focus"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "label": { "type": "string", "minLength": 1, "maxLength": 48 },
          "focus": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/id" }
          },
          "note": { "type": "string", "maxLength": 140 }
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "revision"],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "provider": { "enum": ["github", "gitee", "gitlab"] },
        "link_mode": { "enum": ["web", "local-only"] },
        "revision": { "type": "string", "pattern": "^[a-fA-F0-9]{40}$" }
      }
    },
    "sourceReferences": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 240 },
          "line": { "type": "integer", "minimum": 1 },
          "end_line": { "type": "integer", "minimum": 1 },
          "label": { "type": "string", "minLength": 1, "maxLength": 48 }
        }
      }
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dot", "title", "items"],
        "properties": {
          "dot": { "enum": ["cyan", "emerald", "violet", "amber", "rose", "orange", "slate"] },
          "title": { "type": "string", "minLength": 1 },
          "items": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "operationalRole": {
      "description": "What a component does at run time. Omitted roles are inferred from the component type and label and marked assumed.",
      "enum": ["ingress", "gateway", "stateless-compute", "stateful-db", "cache", "message-broker", "stream", "object-store", "identity", "external-saas", "ai-model", "cdn", "load-balancer"]
    },
    "nodeOperational": {
      "description": "Optional operational contract of a component. Every field is optional; values not given are assumed by the model and labelled as assumptions.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": { "$ref": "#/$defs/operationalRole" },
        "c4_level": { "enum": ["context", "container", "component", "code"] },
        "drilldown_diagram_id": { "$ref": "#/$defs/id" },
        "managed_by": {
          "description": "Who operates the component. provider: a managed service whose redundancy is the provider's, so a review does not recommend redeploying it. customer: something this design deploys. When absent it is inferred from the role and marked as inferred.",
          "enum": ["provider", "customer"]
        },
        "sla_percent": { "description": "Availability of one deployment unit, in percent.", "type": "number", "minimum": 0, "maximum": 100 },
        "redundancy": { "enum": ["single-instance", "multi-az", "active-active-multi-region", "active-passive-dr"] },
        "capacity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_rps": { "description": "Sustainable requests per second of one instance.", "type": "number", "exclusiveMinimum": 0 },
            "baseline_rps": { "description": "Offered load at normal traffic (meaningful on entry components).", "type": "number", "minimum": 0 },
            "cpu_cores": { "type": "number", "exclusiveMinimum": 0 },
            "memory_gb": { "type": "number", "exclusiveMinimum": 0 },
            "autoscale_min": { "type": "integer", "minimum": 1 },
            "autoscale_max": { "type": "integer", "minimum": 1 },
            "scaling_lag_sec": { "type": "number", "minimum": 0 }
          }
        },
        "latency": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "p50_ms": { "type": "number", "minimum": 0 },
            "p95_ms": { "type": "number", "minimum": 0 },
            "p99_ms": { "type": "number", "minimum": 0 }
          }
        },
        "dr": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rpo_sec": { "type": "number", "minimum": 0 },
            "rto_sec": { "type": "number", "minimum": 0 },
            "backup_strategy": { "type": "string", "minLength": 1 }
          }
        },
        "finops": {
          "description": "Cost inputs. Prices are never invented: a component with no price is listed as unpriced, and a meter whose quantity is unknown is left out, not counted as zero. The first four cost fields are the earlier, simpler form and remain supported; meters express every billed dimension with its source.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cloud_provider": { "type": "string", "minLength": 1 },
            "instance_tier": { "type": "string", "minLength": 1 },
            "monthly_base_cost_usd": { "type": "number", "minimum": 0 },
            "cost_per_million_requests_usd": { "type": "number", "minimum": 0 },
            "storage_gb": { "type": "number", "minimum": 0 },
            "storage_cost_per_gb_usd": { "type": "number", "minimum": 0 },
            "pricing_model": {
              "description": "How the service is billed. It tells the estimate which dimensions must be priced before a component total can be called complete.",
              "enum": ["serverless-request", "serverless-instance", "provisioned-instance", "provisioned-with-storage", "storage", "data-transfer", "flat-monthly"]
            },
            "usage": {
              "description": "Monthly usage the meters are multiplied by. What is not stated here is derived from the modelled load when possible, and otherwise reported as missing.",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "requests_per_month": { "type": "number", "minimum": 0 },
                "avg_duration_ms": { "description": "Average billed duration of one request.", "type": "number", "exclusiveMinimum": 0 },
                "memory_gb": { "description": "Configured memory in GB (10^9 bytes).", "type": "number", "exclusiveMinimum": 0 },
                "memory_gib": { "description": "Configured memory in GiB (2^30 bytes). Give memory_gb or memory_gib, not both.", "type": "number", "exclusiveMinimum": 0 },
                "vcpu": { "type": "number", "exclusiveMinimum": 0 },
                "concurrency": { "description": "Requests one instance serves at a time (for instance-time billing).", "type": "number", "exclusiveMinimum": 0 },
                "instances": { "description": "Instances running all month (for instance-hours and provisioned billing).", "type": "number", "minimum": 0 },
                "storage_gb": { "type": "number", "minimum": 0 },
                "operations_per_month": { "type": "number", "minimum": 0 },
                "transfer_gb_per_month": { "type": "number", "minimum": 0 }
              }
            },
            "meters": {
              "description": "The billed dimensions of this component.",
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/billingMeter" }
            }
          }
        },
        "security": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "trust_zone": { "type": "string", "minLength": 1 },
            "auth_method": { "enum": ["none", "api-key", "basic", "jwt", "oauth2-oidc", "saml", "iam", "mtls"] },
            "encryption_at_rest": { "type": "boolean" },
            "encryption_in_transit": { "type": "boolean" },
            "compliance_tags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "public_exposed": { "type": "boolean" }
          }
        }
      }
    },
    "edgeOperational": {
      "description": "Optional operational contract of a relationship. Every field is optional.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "call_semantics": { "enum": ["sync-blocking", "async-queue", "async-pubsub", "event-stream", "replication-sync", "replication-async", "failover-route", "heartbeat"] },
        "protocol": { "enum": ["HTTPS/REST", "gRPC", "GraphQL", "Kafka", "AMQP", "WebSockets", "TCP", "SQL", "CDC"] },
        "resilience": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "timeout_ms": { "type": "number", "exclusiveMinimum": 0 },
            "retries": { "type": "integer", "minimum": 0, "maximum": 10 },
            "backoff_strategy": { "enum": ["none", "fixed", "linear", "exponential"] },
            "jitter": { "type": "boolean" },
            "circuit_breaker_enabled": { "type": "boolean" },
            "circuit_breaker_threshold_pct": { "type": "number", "minimum": 0, "maximum": 100 },
            "fallback_edge_id": { "$ref": "#/$defs/id" },
            "dlq_node_id": { "$ref": "#/$defs/id" },
            "idempotent": { "type": "boolean" }
          }
        },
        "traffic": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "request_multiplier": { "description": "Calls on this relationship per request handled by the source.", "type": "number", "minimum": 0 },
            "payload_kb": { "type": "number", "minimum": 0 },
            "read_write_ratio": { "description": "Fraction of calls that are reads (0 to 1).", "type": "number", "minimum": 0, "maximum": 1 },
            "egress_cost_per_gb_usd": { "type": "number", "minimum": 0 },
            "egress_price_source": { "$ref": "#/$defs/priceSource" }
          }
        }
      }
    },
    "priceSource": {
      "description": "Where a price came from, so it can be audited and refreshed. A price with no source is treated as an unaudited, authored figure.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "origin": { "description": "authored: typed in by the author. imported: copied from a price list or calculator.", "enum": ["authored", "imported"] },
        "provider": { "description": "Cloud provider or vendor, for example aws, azure, gcp.", "type": "string", "minLength": 1 },
        "service": { "type": "string", "minLength": 1 },
        "meter": { "description": "The billing meter as the provider names it.", "type": "string", "minLength": 1 },
        "sku": { "description": "SKU or equivalent identifier, when the provider publishes one.", "type": "string", "minLength": 1 },
        "region": { "type": "string", "minLength": 1 },
        "plan": { "description": "Pricing plan or purchase model, for example on-demand, consumption, reserved-1y.", "type": "string", "minLength": 1 },
        "commitment": { "description": "Commitment or discount assumed, for example none, savings-plan-1y.", "type": "string", "minLength": 1 },
        "url": { "description": "Page the price was read from.", "type": "string", "pattern": "^https://" },
        "retrieved_at": { "description": "Date the price was read, yyyy-mm-dd.", "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "effective_at": { "description": "Date the price took effect, when known, yyyy-mm-dd.", "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    },
    "billingMeter": {
      "description": "One billed dimension of a component: what is charged, in which unit, at what price, with which free allowance, and where the price came from.",
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "currency"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "description": { "type": "string", "minLength": 1 },
        "dimension": {
          "description": "What is billed. \"other\" records a charge the model cannot calculate: it is reported as unsupported and left out.",
          "enum": ["requests", "memory-seconds", "vcpu-seconds", "instance-hours", "storage-gb-month", "operations", "data-transfer-gb", "flat", "other"]
        },
        "unit": {
          "description": "Unit the price is quoted in. It must measure the dimension, for example GB-second or GiB-second for memory-seconds.",
          "enum": ["request", "GB-second", "GiB-second", "vCPU-second", "vCPU-hour", "hour", "month", "GB-month", "GiB-month", "TB-month", "operation", "GB", "GiB", "TB"]
        },
        "price": { "description": "Price for `per` units, in `currency`.", "type": "number", "minimum": 0 },
        "per": { "description": "Number of units the price buys, for example 1000000 for a price per million requests.", "type": "number", "exclusiveMinimum": 0 },
        "currency": { "description": "ISO currency code. Only USD is calculated; another currency is reported as unsupported.", "type": "string", "pattern": "^[A-Z]{3}$" },
        "free_allowance": { "description": "Units per month that are free, applied before the price or tiers.", "type": "number", "minimum": 0 },
        "tiers": {
          "description": "Graduated prices instead of `price`: each tier applies up to its limit (in units, after the free allowance). The last tier may omit up_to.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["price"],
            "properties": {
              "up_to": { "type": "number", "exclusiveMinimum": 0 },
              "price": { "type": "number", "minimum": 0 }
            }
          }
        },
        "quantity_basis": {
          "description": "How billed seconds are counted for memory-seconds and vcpu-seconds. request-duration: each request for its own duration. instance-time: instances while serving, divided by concurrency. provisioned: all month.",
          "enum": ["request-duration", "instance-time", "provisioned"]
        },
        "source": { "$ref": "#/$defs/priceSource" }
      }
    },
    "boundaryOperational": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": { "enum": ["region", "availability-zone", "trust-zone"] },
        "trust_zone": { "type": "string", "minLength": 1 }
      }
    }
  }
}
