{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OWNER/archi-made-easy/schemas/common.schema.json",
  "title": "Archi-Made-Easy Shared Definitions",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
      "maxLength": 35
    },
    "translations": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-zA-Z0-9]*(\\.[a-z][a-zA-Z0-9]*)*$" },
      "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 400 },
      "maxProperties": 600
    },
    "animation": {
      "enum": ["trace", "none"]
    },
    "visualPreset": {
      "enum": ["classic", "signal-flow", "blueprint", "editorial"]
    },
    "qualityProfile": {
      "enum": ["standard", "showcase"]
    },
    "portableOutputPath": {
      "description": "A portable POSIX-relative HTML output path. It must be safe to interpret identically on every supported host filesystem.",
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/]+(?:/[^/]+)*$",
      "allOf": [
        { "pattern": "(?:^|/)[^/]+[.][Hh][Tt][Mm][Ll]$" },
        { "not": { "pattern": "[\\\\<>:\"|?*\\u0000-\\u001F\\u007F-\\u009F]" } },
        { "not": { "pattern": "[\\uD800-\\uDFFF]" } },
        { "not": { "pattern": "(^|/)[.]{1,2}(/|$)" } },
        { "not": { "pattern": "[. ](/|$)" } },
        { "not": { "pattern": "(^|/)[^/]{256}" } },
        {
          "not": {
            "pattern": "(^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Nn][Ii][Nn][$]|[Cc][Oo][Nn][Oo][Uu][Tt][$]|[Cc][Oo][Mm][1-9¹²³]|[Ll][Pp][Tt][1-9¹²³])(?:[.]|/|$)"
          }
        },
        {
          "not": {
            "pattern": "(^|/)[^/]*~[1-9][0-9]*(?:[.]|/|$)"
          }
        }
      ]
    },
    "side": {
      "enum": ["left", "right", "top", "bottom"]
    },
    "relationshipWidth": {
      "type": "number",
      "minimum": 0.5
    },
    "point": {
      "type": "array",
      "prefixItems": [
        { "type": "number" },
        { "type": "number" }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "componentType": {
      "enum": ["frontend", "backend", "database", "cloud", "security", "messagebus", "external"]
    },
    "nodeIcon": {
      "description": "Decorative corner icon. Omit the icon field for the type default; none hides it. Does not change type, color, or legend grouping.",
      "enum": ["calendar", "clock", "person", "briefcase", "flag", "moon", "frontend", "backend", "database", "cloud", "security", "messagebus", "external", "start", "active", "waiting", "decision", "success", "failure", "stop", "neutral", "none"]
    },
    "brandMark": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "anyOf": [
            { "maxLength": 80, "pattern": "^[^\\r\\n]+$" },
            { "pattern": "^https?://" }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "sha256"],
          "properties": {
            "url": { "type": "string", "minLength": 8, "maxLength": 2048, "pattern": "^https?://" },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        }
      ]
    },
    "variant": {
      "enum": ["default", "emphasis", "security", "dashed"]
    },
    "legendMode": {
      "enum": ["auto", "all", "hidden"]
    },
    "legendEntry": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "visible": { "type": "boolean" }
      }
    },
    "guidedViews": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "focus"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "label": { "type": "string", "minLength": 1, "maxLength": 48 },
          "focus": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/id" }
          },
          "note": { "type": "string", "maxLength": 140 }
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "revision"],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "provider": { "enum": ["github", "gitee", "gitlab"] },
        "link_mode": { "enum": ["web", "local-only"] },
        "revision": { "type": "string", "pattern": "^[a-fA-F0-9]{40}$" }
      }
    },
    "sourceReferences": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 240 },
          "line": { "type": "integer", "minimum": 1 },
          "end_line": { "type": "integer", "minimum": 1 },
          "label": { "type": "string", "minLength": 1, "maxLength": 48 }
        }
      }
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dot", "title", "items"],
        "properties": {
          "dot": { "enum": ["cyan", "emerald", "violet", "amber", "rose", "orange", "slate"] },
          "title": { "type": "string", "minLength": 1 },
          "items": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "operationalRole": {
      "description": "What a component does at run time. Omitted roles are inferred from the component type and label and marked assumed.",
      "enum": ["ingress", "gateway", "stateless-compute", "stateful-db", "cache", "message-broker", "stream", "object-store", "identity", "external-saas", "ai-model", "cdn", "load-balancer"]
    },
    "nodeOperational": {
      "description": "Optional operational contract of a component. Every field is optional; values not given are assumed by the model and labelled as assumptions.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": { "$ref": "#/$defs/operationalRole" },
        "c4_level": { "enum": ["context", "container", "component", "code"] },
        "drilldown_diagram_id": { "$ref": "#/$defs/id" },
        "sla_percent": { "description": "Availability of one deployment unit, in percent.", "type": "number", "minimum": 0, "maximum": 100 },
        "redundancy": { "enum": ["single-instance", "multi-az", "active-active-multi-region", "active-passive-dr"] },
        "capacity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_rps": { "description": "Sustainable requests per second of one instance.", "type": "number", "exclusiveMinimum": 0 },
            "baseline_rps": { "description": "Offered load at normal traffic (meaningful on entry components).", "type": "number", "minimum": 0 },
            "cpu_cores": { "type": "number", "exclusiveMinimum": 0 },
            "memory_gb": { "type": "number", "exclusiveMinimum": 0 },
            "autoscale_min": { "type": "integer", "minimum": 1 },
            "autoscale_max": { "type": "integer", "minimum": 1 },
            "scaling_lag_sec": { "type": "number", "minimum": 0 }
          }
        },
        "latency": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "p50_ms": { "type": "number", "minimum": 0 },
            "p95_ms": { "type": "number", "minimum": 0 },
            "p99_ms": { "type": "number", "minimum": 0 }
          }
        },
        "dr": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rpo_sec": { "type": "number", "minimum": 0 },
            "rto_sec": { "type": "number", "minimum": 0 },
            "backup_strategy": { "type": "string", "minLength": 1 }
          }
        },
        "finops": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cloud_provider": { "type": "string", "minLength": 1 },
            "instance_tier": { "type": "string", "minLength": 1 },
            "monthly_base_cost_usd": { "type": "number", "minimum": 0 },
            "cost_per_million_requests_usd": { "type": "number", "minimum": 0 },
            "storage_gb": { "type": "number", "minimum": 0 },
            "storage_cost_per_gb_usd": { "type": "number", "minimum": 0 }
          }
        },
        "security": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "trust_zone": { "type": "string", "minLength": 1 },
            "auth_method": { "enum": ["none", "api-key", "basic", "jwt", "oauth2-oidc", "saml", "iam", "mtls"] },
            "encryption_at_rest": { "type": "boolean" },
            "encryption_in_transit": { "type": "boolean" },
            "compliance_tags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "public_exposed": { "type": "boolean" }
          }
        }
      }
    },
    "edgeOperational": {
      "description": "Optional operational contract of a relationship. Every field is optional.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "call_semantics": { "enum": ["sync-blocking", "async-queue", "async-pubsub", "event-stream", "replication-sync", "replication-async", "failover-route", "heartbeat"] },
        "protocol": { "enum": ["HTTPS/REST", "gRPC", "GraphQL", "Kafka", "AMQP", "WebSockets", "TCP", "SQL", "CDC"] },
        "resilience": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "timeout_ms": { "type": "number", "exclusiveMinimum": 0 },
            "retries": { "type": "integer", "minimum": 0, "maximum": 10 },
            "backoff_strategy": { "enum": ["none", "fixed", "linear", "exponential"] },
            "jitter": { "type": "boolean" },
            "circuit_breaker_enabled": { "type": "boolean" },
            "circuit_breaker_threshold_pct": { "type": "number", "minimum": 0, "maximum": 100 },
            "fallback_edge_id": { "$ref": "#/$defs/id" },
            "dlq_node_id": { "$ref": "#/$defs/id" },
            "idempotent": { "type": "boolean" }
          }
        },
        "traffic": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "request_multiplier": { "description": "Calls on this relationship per request handled by the source.", "type": "number", "minimum": 0 },
            "payload_kb": { "type": "number", "minimum": 0 },
            "read_write_ratio": { "description": "Fraction of calls that are reads (0 to 1).", "type": "number", "minimum": 0, "maximum": 1 },
            "egress_cost_per_gb_usd": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "boundaryOperational": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": { "enum": ["region", "availability-zone", "trust-zone"] },
        "trust_zone": { "type": "string", "minLength": 1 }
      }
    }
  }
}
