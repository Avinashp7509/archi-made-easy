{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Avinashp7509/archi-made-easy/schemas/architecture.schema.json",
  "title": "Archi-Made-Easy Architecture Diagram",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "diagram_type", "meta", "components"],
  "properties": {
    "schema_version": { "const": 1 },
    "diagram_type": { "const": "architecture" },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "output"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "locale": { "$ref": "common.schema.json#/$defs/locale" },
        "translations": { "$ref": "common.schema.json#/$defs/translations" },
        "subtitle": { "type": "string" },
        "output": { "$ref": "common.schema.json#/$defs/portableOutputPath" },
        "animation": { "$ref": "common.schema.json#/$defs/animation" },
        "visual_preset": { "$ref": "common.schema.json#/$defs/visualPreset" },
        "quality_profile": { "$ref": "common.schema.json#/$defs/qualityProfile" },
        "engineering_profile": { "enum": ["deployment-ownership"] },
        "repository": { "$ref": "common.schema.json#/$defs/repository" },
        "views": { "$ref": "common.schema.json#/$defs/guidedViews" },
        "legend": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": { "$ref": "common.schema.json#/$defs/legendMode" },
            "entries": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "frontend": { "$ref": "common.schema.json#/$defs/legendEntry" },
                "backend": { "$ref": "common.schema.json#/$defs/legendEntry" },
                "database": { "$ref": "common.schema.json#/$defs/legendEntry" },
                "cloud": { "$ref": "common.schema.json#/$defs/legendEntry" },
                "security": { "$ref": "common.schema.json#/$defs/legendEntry" },
                "messagebus": { "$ref": "common.schema.json#/$defs/legendEntry" },
                "external": { "$ref": "common.schema.json#/$defs/legendEntry" }
              }
            }
          }
        },
        "viewBox": {
          "type": "array",
          "prefixItems": [
            { "type": "number", "minimum": 320 },
            { "type": "number", "minimum": 240 }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["grid"] },
        "origin": { "$ref": "common.schema.json#/$defs/point" },
        "cols": { "type": "integer", "minimum": 1, "maximum": 12 },
        "gapX": { "type": "number", "minimum": 0 },
        "gapY": { "type": "number", "minimum": 0 },
        "cellW": { "type": "number", "minimum": 40 },
        "cellH": { "type": "number", "minimum": 24 }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "label"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "type": { "$ref": "common.schema.json#/$defs/componentType" },
          "label": { "type": "string", "minLength": 1 },
          "sublabel": { "type": "string" },
          "tag": { "type": "string" },
          "icon": { "$ref": "common.schema.json#/$defs/nodeIcon" },
          "brand": { "$ref": "common.schema.json#/$defs/brandMark" },
          "sources": { "$ref": "common.schema.json#/$defs/sourceReferences" },
          "row": { "type": "integer", "minimum": 0 },
          "col": { "type": "integer", "minimum": 0 },
          "pos": { "$ref": "common.schema.json#/$defs/point" },
          "size": {
            "type": "array",
            "prefixItems": [
              { "type": "number", "exclusiveMinimum": 0 },
              { "type": "number", "exclusiveMinimum": 0 }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "operational": { "$ref": "common.schema.json#/$defs/nodeOperational" }
        }
      }
    },
    "boundaries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "label", "wraps"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "kind": { "enum": ["region", "security-group"] },
          "label": { "type": "string", "minLength": 1 },
          "wraps": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "common.schema.json#/$defs/id" }
          },
          "pad": { "type": "number", "minimum": 0 },
          "operational": { "$ref": "common.schema.json#/$defs/boundaryOperational" }
        }
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "from": { "$ref": "common.schema.json#/$defs/id" },
          "to": { "$ref": "common.schema.json#/$defs/id" },
          "label": { "type": "string" },
          "variant": { "$ref": "common.schema.json#/$defs/variant" },
          "fromSide": { "$ref": "common.schema.json#/$defs/side" },
          "toSide": { "$ref": "common.schema.json#/$defs/side" },
          "route": { "enum": ["auto", "straight", "orthogonal-h", "orthogonal-v"] },
          "via": {
            "type": "array",
            "items": { "$ref": "common.schema.json#/$defs/point" }
          },
          "labelAt": { "$ref": "common.schema.json#/$defs/point" },
          "labelDx": { "type": "number" },
          "labelDy": { "type": "number" },
          "labelSegment": { "type": "integer", "minimum": 0 },
          "width": { "$ref": "common.schema.json#/$defs/relationshipWidth" },
          "operational": { "$ref": "common.schema.json#/$defs/edgeOperational" }
        }
      }
    },
    "cards": { "$ref": "common.schema.json#/$defs/cards" },
    "workbench": {
      "description": "Optional architecture-workbench data: requirements, decisions, traces, alternatives and drill-down diagrams.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entrypoints": {
          "description": "Components where user traffic enters. Inferred when omitted.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "common.schema.json#/$defs/id" }
        },
        "requirements": {
          "description": "Non-functional targets, for example from a requirements document. Review compares the design against them.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "availability_target_percent": { "type": "number", "minimum": 0, "maximum": 100 },
            "p99_latency_ms": { "type": "number", "exclusiveMinimum": 0 },
            "peak_rps": { "type": "number", "exclusiveMinimum": 0 },
            "rpo_sec": { "type": "number", "minimum": 0 },
            "rto_sec": { "type": "number", "minimum": 0 },
            "monthly_budget_usd": { "type": "number", "minimum": 0 },
            "users": { "type": "number", "minimum": 0 },
            "regions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "data_residency": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "compliance": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        },
        "adrs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "status", "decision"],
            "properties": {
              "id": { "$ref": "common.schema.json#/$defs/id" },
              "title": { "type": "string", "minLength": 1 },
              "status": { "enum": ["proposed", "accepted", "superseded"] },
              "context": { "type": "string" },
              "decision": { "type": "string", "minLength": 1 },
              "alternatives": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["option"],
                  "properties": {
                    "option": { "type": "string", "minLength": 1 },
                    "pros": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                    "cons": { "type": "array", "items": { "type": "string", "minLength": 1 } }
                  }
                }
              },
              "consequences": { "type": "string" }
            }
          }
        },
        "traces": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "kind", "steps"],
            "properties": {
              "id": { "$ref": "common.schema.json#/$defs/id" },
              "title": { "type": "string", "minLength": 1 },
              "kind": { "enum": ["happy", "failover"] },
              "steps": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["edge"],
                  "properties": {
                    "edge": { "$ref": "common.schema.json#/$defs/id" },
                    "note": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          }
        },
        "alternatives": {
          "description": "Named change sets compared side by side with the authored design.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title"],
            "properties": {
              "id": { "$ref": "common.schema.json#/$defs/id" },
              "title": { "type": "string", "minLength": 1 },
              "description": { "type": "string" },
              "component_overrides": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "operational"],
                  "properties": {
                    "id": { "$ref": "common.schema.json#/$defs/id" },
                    "operational": { "$ref": "common.schema.json#/$defs/nodeOperational" }
                  }
                }
              },
              "connection_overrides": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "operational"],
                  "properties": {
                    "id": { "$ref": "common.schema.json#/$defs/id" },
                    "operational": { "$ref": "common.schema.json#/$defs/edgeOperational" }
                  }
                }
              }
            }
          }
        },
        "drilldowns": {
          "description": "Child architecture diagrams opened from components that name them in operational.drilldown_diagram_id.",
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "spec"],
            "properties": {
              "id": { "$ref": "common.schema.json#/$defs/id" },
              "title": { "type": "string", "minLength": 1 },
              "spec": { "$ref": "#" }
            }
          }
        }
      }
    }
  }
}
