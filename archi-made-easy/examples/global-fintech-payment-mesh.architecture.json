        "latency": { "p50_ms": 9, "p99_ms": 55 }, "dr": { "rpo_sec": 0, "rto_sec": 60, "backup_strategy": "Synchronous standby in a second zone; point-in-time recovery" },
        "security": { "auth_method": "iam", "encryption_at_rest": true, "encryption_in_transit": true, "trust_zone": "data", "compliance_tags": ["PCI-DSS"] },
        "finops": { "monthly_base_cost_usd": 6800, "storage_gb": 4000, "storage_cost_per_gb_usd": 0.12 } } },
    { "id": "stream", "type": "messagebus", "label": "Settlement events", "sublabel": "Ordered, replayable", "row": 1, "col": 4,
      "operational": { "role": "stream", "sla_percent": 99.95, "redundancy": "active-active-multi-region", "capacity": { "max_rps": 40000 },
        "security": { "auth_method": "iam", "encryption_at_rest": true, "encryption_in_transit": true, "trust_zone": "data" },
        "finops": { "monthly_base_cost_usd": 2100 } } },
    { "id": "ledger_b", "type": "database", "label": "Ledger B", "sublabel": "Double-entry books", "row": 2, "col": 4,
      "operational": { "role": "stateful-db", "sla_percent": 99.99, "redundancy": "multi-az", "capacity": { "max_rps": 14000 },
        "latency": { "p50_ms": 9, "p99_ms": 55 }, "dr": { "rpo_sec": 0, "rto_sec": 60, "backup_strategy": "Synchronous standby in a second zone; point-in-time recovery" },
        "security": { "auth_method": "iam", "encryption_at_rest": true, "encryption_in_transit": true, "trust_zone": "data", "compliance_tags": ["PCI-DSS"] },
