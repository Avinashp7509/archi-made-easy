        "latency": { "p50_ms": 35, "p99_ms": 140 }, "security": { "auth_method": "mtls", "encryption_in_transit": true, "trust_zone": "payments" },
        "finops": { "monthly_base_cost_usd": 5200, "cost_per_million_requests_usd": 4 } } },
    { "id": "pay_b", "type": "backend", "label": "Payments B", "sublabel": "Authorise, capture", "row": 2, "col": 3,
      "operational": { "role": "stateless-compute", "sla_percent": 99.95, "redundancy": "multi-az", "capacity": { "max_rps": 300, "autoscale_min": 3, "autoscale_max": 12 },
        "latency": { "p50_ms": 45, "p99_ms": 180 }, "security": { "auth_method": "mtls", "encryption_in_transit": true, "trust_zone": "payments", "compliance_tags": ["PCI-DSS"] },
