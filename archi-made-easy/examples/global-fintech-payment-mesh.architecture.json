        "latency": { "p50_ms": 45, "p99_ms": 180 }, "security": { "auth_method": "mtls", "encryption_in_transit": true, "trust_zone": "payments", "compliance_tags": ["PCI-DSS"] },
        "finops": { "monthly_base_cost_usd": 3600, "cost_per_million_requests_usd": 1.2 } } },
    { "id": "fraud", "type": "backend", "label": "Fraud scoring", "sublabel": "Model, rule fallback", "row": 1, "col": 3,
