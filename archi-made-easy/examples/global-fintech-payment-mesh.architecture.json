        "latency": { "p50_ms": 12, "p99_ms": 60 }, "security": { "auth_method": "mtls", "encryption_in_transit": true, "trust_zone": "identity" },
        "finops": { "monthly_base_cost_usd": 1500 } } },
    { "id": "gw_b", "type": "backend", "label": "API gateway B", "sublabel": "Auth, limits, routes", "row": 2, "col": 2,
      "operational": { "role": "gateway", "sla_percent": 99.95, "redundancy": "multi-az", "capacity": { "max_rps": 1500, "autoscale_min": 2, "autoscale_max": 4 },
        "latency": { "p50_ms": 6, "p99_ms": 30 }, "security": { "auth_method": "oauth2-oidc", "encryption_in_transit": true, "trust_zone": "dmz" },
