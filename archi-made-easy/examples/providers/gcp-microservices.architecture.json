{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "Microservices with an API gateway on Google Cloud",
    "output": "gcp-microservices.html",
    "quality_profile": "showcase"
  },
  "layout": {
    "mode": "grid",
    "origin": [
      40,
      110
    ],
    "cols": 4,
    "cellW": 130,
    "cellH": 60,
    "gapX": 80,
    "gapY": 80
  },
  "components": [
    {
      "id": "users",
      "type": "external",
      "label": "Users",
      "sublabel": "Web / mobile",
      "row": 1,
      "col": 0,
      "operational": {
        "role": "ingress",
        "security": {
          "public_exposed": true
        }
      }
    },
    {
      "id": "identity",
      "type": "security",
      "label": "Identity Plat.",
      "sublabel": "Token issuer",
      "row": 0,
      "col": 1,
      "operational": {
        "role": "identity",
        "security": {
          "auth_method": "oauth2-oidc"
        }
      }
    },
    {
      "id": "gateway",
      "type": "backend",
      "label": "Apigee",
      "sublabel": "Routing, auth, limits",
      "row": 1,
      "col": 1,
      "operational": {
        "role": "gateway",
        "redundancy": "multi-az",
        "security": {
          "public_exposed": true,
          "auth_method": "jwt"
        }
      }
    },
    {
      "id": "orders",
      "type": "backend",
      "label": "Orders service",
      "sublabel": "Owns order data",
      "row": 0,
      "col": 2,
      "operational": {
        "role": "stateless-compute",
        "redundancy": "multi-az",
        "capacity": {
          "autoscale_min": 2,
          "autoscale_max": 10
        }
      }
    },
    {
      "id": "bus",
      "type": "messagebus",
      "label": "Pub/Sub",
      "sublabel": "Domain events",
      "row": 1,
      "col": 2,
      "operational": {
        "role": "stream",
        "redundancy": "multi-az"
      }
    },
    {
      "id": "payments",
      "type": "backend",
      "label": "Payments service",
      "sublabel": "Owns payment data",
      "row": 2,
      "col": 2,
      "operational": {
        "role": "stateless-compute",
        "redundancy": "multi-az",
        "capacity": {
          "autoscale_min": 2,
          "autoscale_max": 10
        }
      }
    },
    {
      "id": "orders_db",
      "type": "database",
      "label": "Cloud SQL",
      "sublabel": "Orders data",
      "row": 0,
      "col": 3,
      "operational": {
        "role": "stateful-db",
        "redundancy": "multi-az",
        "security": {
          "encryption_at_rest": true
        }
      }
    },
    {
      "id": "notifier",
      "type": "backend",
      "label": "Functions",
      "sublabel": "Notifications",
      "row": 1,
      "col": 3,
      "operational": {
        "role": "stateless-compute",
        "redundancy": "multi-az"
      }
    },
    {
      "id": "payments_db",
      "type": "database",
      "label": "Cloud SQL",
      "sublabel": "Payments data",
      "row": 2,
      "col": 3,
      "operational": {
        "role": "stateful-db",
        "redundancy": "multi-az",
        "security": {
          "encryption_at_rest": true
        }
      }
    }
  ],
  "boundaries": [
    {
      "id": "region",
      "kind": "region",
      "label": "Region (zone-redundant)",
      "wraps": [
        "identity",
        "gateway",
        "orders",
        "bus",
        "payments",
        "orders_db",
        "notifier",
        "payments_db"
      ],
      "operational": {
        "scope": "region"
      }
    }
  ],
  "connections": [
    {
      "id": "users-gateway",
      "from": "users",
      "to": "gateway",
      "label": "HTTPS",
      "variant": "emphasis",
      "operational": {
        "call_semantics": "sync-blocking",
        "protocol": "HTTPS/REST"
      }
    },
    {
      "id": "gateway-identity",
      "from": "gateway",
      "to": "identity",
      "label": "validate",
      "variant": "security",
      "operational": {
        "call_semantics": "sync-blocking",
        "protocol": "HTTPS/REST",
        "resilience": {
          "circuit_breaker_enabled": true
        }
      }
    },
    {
      "id": "gateway-orders",
      "from": "gateway",
      "to": "orders",
      "operational": {
        "call_semantics": "sync-blocking",
        "protocol": "HTTPS/REST",
        "resilience": {
          "circuit_breaker_enabled": true
        }
      }
    },
    {
      "id": "gateway-payments",
      "from": "gateway",
      "to": "payments",
      "operational": {
        "call_semantics": "sync-blocking",
        "protocol": "HTTPS/REST",
        "resilience": {
          "circuit_breaker_enabled": true
        }
      }
    },
    {
      "id": "orders-db",
      "from": "orders",
      "to": "orders_db",
      "label": "SQL",
      "operational": {
        "call_semantics": "sync-blocking",
        "protocol": "SQL"
      }
    },
    {
      "id": "payments-db",
      "from": "payments",
      "to": "payments_db",
      "label": "SQL",
      "operational": {
        "call_semantics": "sync-blocking",
        "protocol": "SQL"
      }
    },
    {
      "id": "orders-bus",
      "from": "orders",
      "to": "bus",
      "label": "publish",
      "variant": "dashed",
      "operational": {
        "call_semantics": "event-stream",
        "resilience": {
          "idempotent": true
        }
      }
    },
    {
      "id": "bus-payments",
      "from": "bus",
      "to": "payments",
      "label": "consume",
      "variant": "dashed",
      "operational": {
        "call_semantics": "event-stream",
        "resilience": {
          "idempotent": true
        }
      }
    },
    {
      "id": "bus-notifier",
      "from": "bus",
      "to": "notifier",
      "label": "consume",
      "variant": "dashed",
      "operational": {
        "call_semantics": "event-stream",
        "resilience": {
          "idempotent": true
        }
      }
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Edge",
      "items": [
        "Apigee is the single entry point: routing, authentication, rate limits"
      ]
    },
    {
      "dot": "emerald",
      "title": "Services",
      "items": [
        "Each service owns its database; no shared tables",
        "Cross-service workflows use events on Pub/Sub, not call chains"
      ]
    },
    {
      "dot": "rose",
      "title": "Resilience",
      "items": [
        "Gateway calls sit behind circuit breakers",
        "Event consumers are idempotent"
      ]
    },
    {
      "dot": "amber",
      "title": "Assumptions",
      "items": [
        "Two services are shown as examples; add yours with the same shape",
        "Traffic, latency and cost figures are not set: add real numbers before relying on analysis",
        "Service choices follow the Google Cloud pack (version 0.1.0); confirm they fit your constraints"
      ]
    }
  ],
  "workbench": {
    "adrs": [
      {
        "id": "adr-database-per-service",
        "title": "One database per service",
        "status": "proposed",
        "context": "Services must be deployable and scalable on their own.",
        "decision": "Each service owns its schema; other services use its API or its events.",
        "alternatives": [
          {
            "option": "Shared database",
            "pros": [
              "Simple joins and transactions"
            ],
            "cons": [
              "Couples releases",
              "One schema change can break several services"
            ]
          }
        ],
        "consequences": "Cross-service consistency is eventual and needs sagas or compensating actions."
      }
    ]
  }
}
