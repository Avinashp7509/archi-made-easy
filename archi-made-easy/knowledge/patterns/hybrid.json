{
  "schemaVersion": 1,
  "id": "hybrid",
  "status": "implemented",
  "title": "Hybrid cloud integration",
  "summary": "New cloud workloads work alongside systems that stay on-premises, joined by a private link, synchronised identity and replicated data.",
  "when_to_use": [
    "Core systems must stay on-premises for now",
    "Cloud applications need on-premises data or identity"
  ],
  "layout": { "mode": "grid", "origin": [40, 110], "cols": 5, "cellW": 130, "cellH": 60, "gapX": 80, "gapY": 80 },
  "components": [
    { "id": "directory", "slot": "identity", "label": "Directory", "sublabel": "On-prem identities", "row": 0, "col": 0 },
    { "id": "core", "slot": "external_api", "label": "Core systems", "sublabel": "ERP, mainframe", "type": "backend", "row": 1, "col": 0, "operational": { "role": "stateless-compute" } },
    { "id": "legacy_db", "slot": "relational_db", "label": "On-prem DB", "sublabel": "System of record", "row": 2, "col": 0 },
    { "id": "link", "slot": "hybrid_link", "sublabel": "Private connectivity", "row": 1, "col": 1, "operational": { "redundancy": "single-instance" } },
    { "id": "firewall", "slot": "firewall", "sublabel": "Inspect, restrict", "row": 1, "col": 2 },
    { "id": "cloud_identity", "slot": "identity", "sublabel": "Cloud identities", "row": 0, "col": 3, "operational": { "security": { "auth_method": "oauth2-oidc" } } },
    { "id": "gateway", "slot": "api_gateway", "sublabel": "Integration APIs", "row": 1, "col": 3, "operational": { "redundancy": "multi-az" } },
    { "id": "sync", "slot": "etl", "sublabel": "Data replication", "row": 2, "col": 3 },
    { "id": "app", "slot": "compute_web", "sublabel": "Cloud application", "row": 1, "col": 4, "operational": { "redundancy": "multi-az" } },
    { "id": "cloud_db", "slot": "relational_db", "sublabel": "Cloud copy", "row": 2, "col": 4, "operational": { "redundancy": "multi-az", "security": { "encryption_at_rest": true } } }
  ],
  "boundaries": [
    { "id": "onprem", "kind": "region", "label": "On-premises data centre", "wraps": ["directory", "core", "legacy_db"], "operational": { "scope": "region" } },
    { "id": "cloud", "kind": "region", "label": "Cloud {region_term}", "wraps": ["cloud_identity", "gateway", "sync", "app", "cloud_db"], "operational": { "scope": "region" } }
  ],
  "connections": [
    { "id": "directory-sync", "from": "directory", "to": "cloud_identity", "label": "directory sync", "variant": "dashed", "operational": { "call_semantics": "replication-async" } },
    { "id": "core-link", "from": "core", "to": "link", "operational": { "call_semantics": "sync-blocking" } },
    { "id": "link-firewall", "from": "link", "to": "firewall", "operational": { "call_semantics": "sync-blocking" } },
    { "id": "firewall-gateway", "from": "firewall", "to": "gateway", "label": "APIs", "operational": { "call_semantics": "sync-blocking", "protocol": "HTTPS/REST", "resilience": { "circuit_breaker_enabled": true } } },
    { "id": "gateway-app", "from": "gateway", "to": "app", "operational": { "call_semantics": "sync-blocking", "protocol": "HTTPS/REST" } },
    { "id": "legacy-sync", "from": "legacy_db", "to": "sync", "label": "change data capture", "variant": "dashed", "operational": { "call_semantics": "replication-async", "protocol": "CDC" } },
    { "id": "sync-clouddb", "from": "sync", "to": "cloud_db", "label": "apply", "variant": "dashed", "operational": { "call_semantics": "replication-async" } },
    { "id": "app-clouddb", "from": "app", "to": "cloud_db", "label": "SQL", "operational": { "call_semantics": "sync-blocking", "protocol": "SQL" } }
  ],
  "cards": [
    { "dot": "cyan", "title": "Connectivity", "items": ["{link} carries traffic privately; {firewall} limits what can cross", "A single private link is a single point of failure: add a second path for resilience"] },
    { "dot": "emerald", "title": "Data", "items": ["{sync} copies changes from {legacy_db} to {cloud_db}", "The cloud copy lags the system of record"] },
    { "dot": "rose", "title": "Identity", "items": ["{directory} stays the source of identities and syncs to {cloud_identity}"] }
  ],
  "assumptions": [
    "On-premises systems remain the system of record",
    "Link capacity, replication lag and cost are not set: add real numbers before relying on analysis"
  ],
  "adrs": [
    {
      "id": "adr-replicate-not-call",
      "title": "Replicate data instead of calling on-premises per request",
      "status": "proposed",
      "context": "Cloud applications need on-premises data, and the private link adds latency and a failure point.",
      "decision": "Replicate the needed data to the cloud and read it there.",
      "alternatives": [
        { "option": "Call on-premises systems synchronously", "pros": ["Always current"], "cons": ["Every request depends on the link and the legacy system"] }
      ],
      "consequences": "Cloud reads can be stale; writes still go to the system of record."
    }
  ]
}
